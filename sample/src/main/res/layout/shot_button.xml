<?xml version="1.0" encoding="utf-8"?>
<com.github.simpleviews.SafeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:svFitSystemBars="both">

    <com.github.simpleviews.VStack
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp"
        app:svSpacing="16dp">

        <com.github.simpleviews.SimpleButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Default — theme accent, 12dp corners" />

        <com.github.simpleviews.SimpleButton
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Filled pill"
            app:svExactSize="true"
            app:svCornerRadius="24dp"
            app:svFillColor="#6200EE" />

        <com.github.simpleviews.SimpleButton
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Outlined"
            app:svExactSize="true"
            app:svCornerRadius="12dp"
            app:svFillColor="#00000000"
            app:svStrokeColor="#6200EE"
            app:svStrokeWidth="1dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SimpleButton — svCornerRadius / svFillColor / svStrokeColor; ripple and not-all-caps are defaults"
            android:textColor="#666666" />
    </com.github.simpleviews.VStack>
</com.github.simpleviews.SafeLayout>
