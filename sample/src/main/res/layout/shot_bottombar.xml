<?xml version="1.0" encoding="utf-8"?>
<com.github.simpleviews.BottomActionBar xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:svButtonText="Continue">

    <com.github.simpleviews.VStack
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:svSpacing="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BottomActionBar"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Everything declared inside the tag becomes the content area; the button is pinned below it." />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="The login / onboarding pattern, minus the nesting." />
    </com.github.simpleviews.VStack>
</com.github.simpleviews.BottomActionBar>
