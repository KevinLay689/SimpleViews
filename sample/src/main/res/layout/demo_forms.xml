<?xml version="1.0" encoding="utf-8"?>
<com.github.simpleviews.SafeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:svFitSystemBars="both">

    <com.github.simpleviews.VStack
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        app:svSpacing="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Declarative validation + password toggle"
            android:textStyle="bold"
            android:textSize="18sp" />

        <com.github.simpleviews.ValidatingEditText
            android:id="@+id/emailField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email"
            android:inputType="textEmailAddress"
            app:svValidate="required|email" />

        <com.github.simpleviews.ValidatingEditText
            android:id="@+id/phoneField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Phone (optional)"
            android:inputType="phone"
            app:svValidate="phone" />

        <com.github.simpleviews.PasswordEditText
            android:id="@+id/passwordField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Password" />

        <com.github.simpleviews.SimpleButton
            android:id="@+id/submitButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            app:svExactSize="true"
            android:text="Sign up"
            app:svCornerRadius="12dp" />
    </com.github.simpleviews.VStack>
</com.github.simpleviews.SafeLayout>
