<?xml version="1.0" encoding="utf-8"?>
<com.github.simpleviews.SafeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:svFitSystemBars="both">

    <com.github.simpleviews.VStack
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp"
        app:svSpacing="16dp">

        <com.github.simpleviews.ValidatingEditText
            android:id="@+id/shotEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email"
            android:inputType="textEmailAddress"
            app:svValidate="required|email" />

        <com.github.simpleviews.ValidatingEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Phone (optional)"
            android:inputType="phone"
            app:svValidate="phone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ValidatingEditText — app:svValidate rules; email.validateOrShowError() drew the error below"
            android:textColor="#666666" />
    </com.github.simpleviews.VStack>
</com.github.simpleviews.SafeLayout>
