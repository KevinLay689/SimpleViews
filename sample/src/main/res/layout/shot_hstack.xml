<?xml version="1.0" encoding="utf-8"?>
<com.github.simpleviews.SafeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:svFitSystemBars="both">

    <com.github.simpleviews.VStack
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp"
        app:svSpacing="16dp">

        <com.github.simpleviews.HStack
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:svDistribute="spread"
            app:svSpacing="8dp">

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel" />

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OK" />
        </com.github.simpleviews.HStack>

        <com.github.simpleviews.HStack
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:svSpacing="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="packed" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="children" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="wrap" />
        </com.github.simpleviews.HStack>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HStack — app:svDistribute spread gives equal widths; packed keeps children at wrap size"
            android:textColor="#666666" />
    </com.github.simpleviews.VStack>
</com.github.simpleviews.SafeLayout>
