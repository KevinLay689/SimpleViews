<?xml version="1.0" encoding="utf-8"?>
<com.github.simpleviews.SafeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:svFitSystemBars="both">

    <com.github.simpleviews.VStack
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        app:svSpacing="12dp">

        <com.github.simpleviews.SimpleList
            android:id="@+id/shotList"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            app:svExactSize="true"
            app:svDivider="true"
            app:svItemLayout="@layout/row_person" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SimpleList — list.items = names; no adapter, no ViewHolder, tappable rows built in"
            android:textColor="#666666" />
    </com.github.simpleviews.VStack>
</com.github.simpleviews.SafeLayout>
